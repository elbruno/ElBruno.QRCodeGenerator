<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <RootNamespace>ElBruno.QRCodeGenerator.Pdf</RootNamespace>
    <AssemblyName>ElBruno.QRCodeGenerator.Pdf</AssemblyName>
    
    <!-- NuGet Package Metadata -->
    <PackageId>ElBruno.QRCodeGenerator.Pdf</PackageId>
    <Version>1.1.1</Version>
    <Title>ElBruno QR Code Generator — PDF</Title>
    <Description>Generate PDF documents with embedded QR codes using PDFsharp.</Description>
    <PackageTags>qrcode;pdf;document;pdfsharp;report</PackageTags>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.QRCodeGenerator</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Added .NET 11.0 support and replaced the vulnerable PDF dependency with PDFsharp and a portable, licensed font resolver.</PackageReleaseNotes>
    
    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    
    <!-- NuGet Symbol Package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    
    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf">
      <LogicalName>ElBruno.QRCodeGenerator.Pdf.Fonts.LiberationSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <None Include="Fonts\LiberationFonts-OFL.txt" Pack="true" PackagePath="fonts\LiberationFonts-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\images\nuget_logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
